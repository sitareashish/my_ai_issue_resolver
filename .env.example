# Copy to `.env` and fill in your own values. NEVER commit real secrets.
# (This file is a template only — placeholders, not live keys.)

# ── LLM (agent reasoning) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embeddings ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/your-repo

# ── Qdrant (vector store) ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codebase
QDRANT_API_KEY=

# ── LangSmith (tracing / observability) ───────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=github-issue-resolver

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_RETRIES=5
CONTEXT_TOP_K=15
CONTEXT_RERANK_TOP_K=5
CONFIDENCE_THRESHOLD=0.75
MAX_TOKENS_PER_ISSUE=150000
TOKEN_WARN_THRESHOLD=80000
BM25_WEIGHT=0.3

# ── Docker sandbox ────────────────────────────────────────────────────────────
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_COUNT=2
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_POOL_SIZE=2

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
METRICS_ENABLED=true

# ── Internal ──────────────────────────────────────────────────────────────────
CHECKPOINT_DB=/tmp/resolver_checkpoints.db
